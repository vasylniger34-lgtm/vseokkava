generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CLIENT
  BARISTA
  OWNER
}

enum TransactionType {
  ADD_COFFEE
  REDEEM_FREE
  CANCEL
}

model User {
  id         String   @id @default(uuid())
  telegramId String   @unique
  username   String?  @unique
  role       Role     @default(CLIENT)
  name       String?
  phone      String?
  birthday   DateTime?
  shortCode  String   @unique
  balance    Int      @default(0)
  totalCoffees Int    @default(0)
  freeCoffees Int     @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  
  transactions Transaction[] @relation("UserTransactions")
  baristaTransactions Transaction[] @relation("BaristaTransactions")
}

model Transaction {
  id        String   @id @default(uuid())
  userId    String
  baristaId String?
  type      TransactionType
  amount    Int      @default(1)
  createdAt DateTime @default(now())

  user      User     @relation("UserTransactions", fields: [userId], references: [id])
  barista   User?    @relation("BaristaTransactions", fields: [baristaId], references: [id])
}

model Settings {
  id              String @id @default("default")
  coffeesNeeded   Int    @default(7)
  reminderDays    Int    @default(7)
  reminderText    String @default("Ми сумуємо за вами! Заходьте на каву ☕️")
  trigger6Coffees String @default("Ще одна кава - і наступна безкоштовно! 🎉")
  triggerFree     String @default("Вітаємо! У вас є безкоштовна кава! 🎁")
}

model Location {
  id        String   @id @default(uuid())
  name      String
  address   String?
  active    Boolean  @default(true)
}
